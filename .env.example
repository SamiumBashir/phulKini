# ==========================================
# PHUL KINI v2 — ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/phul_kini
MONGODB_DB=phul_kini

# Authentication & JWT Security
AUTH_SECRET=phulkini_super_secret_jwt_key_2026_change_in_production
AUTH_TOKEN_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials (Used during npm run seed)
INITIAL_ADMIN_NAME="ফুল কিনি অ্যাডমিন"
INITIAL_ADMIN_EMAIL=admin@phulkini.com
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_PHONE=01700000000

# Redis Cache & Rate Limiting (Optional in local development — falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=phulkini
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# SSLCOMMERZ Payment Gateway (Sandbox Mode by default)
SSLCOMMERZ_STORE_ID=phulkinitest
SSLCOMMERZ_STORE_PASSWORD=phulkinitest@ssl
SSLCOMMERZ_IS_LIVE=false

# Security & Cron
CRON_SECRET=phulkini_cron_secret_key_2026
